---
import { useTranslations, path, navOrder, site, type Lang, isZh } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

/* Rendered in this order; any handle left blank in site.social is skipped. */
const rednoteLabel = lang === 'en' ? 'RedNote'
  : lang === 'zh-hant' ? '小紅書'
  : '小红书';

const socials = ([
  ['instagram', 'Instagram'],
  ['threads', 'Threads'],
  ['linkedin', 'LinkedIn'],
  ['facebook', 'Facebook'],
  ['rednote', rednoteLabel],
] as const).filter(([key]) => site.social[key]);
---

<footer class="site-footer">
  <div class="shell shell--wide">
    <div class="footer-grid">
      <div class="footer-brand stack stack-2">
        <p class="footer-name">Speech &amp; ABA Works</p>
        <p class="footer-tagline">{t('footer.tagline')}</p>
        <p class="footer-langs" lang="en">English · 廣東話 · 國語</p>
        {socials.length > 0 && (
          <ul class="footer-social" aria-label={t('footer.connect')}>
            {socials.map(([key, label]) => (
              <li>
                <a
                  href={site.social[key]}
                  rel="me noopener"
                  target="_blank"
                  aria-label={label}
                  title={label}
                >
                  <Icon name={key} size={20} label={label} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <nav class="footer-col" aria-label={t('footer.explore')}>
        <h2 class="footer-head">{t('footer.explore')}</h2>
        <ul>
          <li><a href={path('home', lang)}>{t('nav.home')}</a></li>
          {navOrder.map((key) => (
            <li><a href={path(key, lang)}>{t(`nav.${key}` as any)}</a></li>
          ))}
          <li><a href={path('testimonials', lang)}>{t('nav.testimonials')}</a></li>
          <li><a href={path('contact', lang)}>{t('nav.contact')}</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-head">{t('footer.connect')}</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-head">{t('footer.legal')}</h2>
        <ul>
          <li><a href={path('privacy', lang)}>{t('footer.privacy')}</a></li>
          <li><a href={path('terms', lang)}>{t('footer.terms')}</a></li>
          <li><a href={path('disclaimer', lang)}>{t('footer.disclaimer')}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p class="small muted">© {year} Speech &amp; ABA Works. {t('footer.rights')}</p>
      <p class="small muted footer-note">{t('footer.builtNote')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-2);
    border-top: 1px solid var(--rule);
    padding-block: 3.25rem 2rem;
    margin-top: 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 1.6fr) repeat(3, minmax(9rem, 1fr));
    gap: 2rem 2.25rem;
  }
  @media (max-width: 56rem) {
    .footer-grid { grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }

  .footer-name {
    font-family: var(--f-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
  }
  .footer-tagline { font-size: .9375rem; color: var(--ink-soft); max-width: 34ch; }
  .footer-langs { font-size: .8125rem; color: var(--ink-faint); letter-spacing: .05em; }

  .footer-social {
    list-style: none;
    margin: .35rem 0 0;
    padding: 0;
    display: flex;
    gap: .5rem;
  }
  .footer-social li { max-width: none; }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color .15s ease, border-color .15s ease, background-color .15s ease;
  }
  .footer-social a:hover,
  .footer-social a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--brand-tint);
  }

  .footer-col { display: flex; flex-direction: column; gap: .7rem; }
  .footer-head {
    font-family: var(--f-body);
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; }
  .footer-col li { max-width: none; }
  .footer-col a {
    font-size: .9375rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .footer-col a:hover { color: var(--accent); text-decoration: underline; }

  .footer-base {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 2rem;
    justify-content: space-between;
    align-items: baseline;
  }
  .footer-note { max-width: 48ch; }
</style>
