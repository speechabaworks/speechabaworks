---
/**
 * One testimonial.
 *
 *   compact — the short excerpt and who said it. Home page and Services.
 *   full    — adds the complete testimony behind "Read the full testimony",
 *             and, for a translation, the words as written behind
 *             "Show the original".
 *
 * A translated excerpt is labelled on the card itself, not only inside the
 * expanded text, because the excerpt is a translation too.
 */
import type { CollectionEntry } from 'astro:content';
import { useTranslations, isZh, type Lang } from '../i18n/ui';

interface Props {
  item: CollectionEntry<'testimonials'> & { slug?: string };
  lang: Lang;
  mode?: 'compact' | 'full';
}
const { item, lang, mode = 'compact' } = Astro.props;
const t = useTranslations(lang);
const d = item.data;

const paras = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const [open, close] = isZh(lang) ? ['「', '」'] : ['“', '”'];

const translatedNote = d.originalLang
  ? d.originalLang === 'en' ? t('testimonials.fromEn') : t('testimonials.fromZh')
  : '';

// Someone identified by role only has the role as their headline.
const who = d.name || d.role;
const detail = d.name ? d.role : '';
---

<figure class={`tcard tcard--${mode}`} id={item.slug}>
  {d.title && <p class="tcard-title">{d.title}</p>}
  <blockquote class="tcard-pull">
    <p>{open}{d.pull}{close}</p>
  </blockquote>

  <figcaption class="tcard-by">
    <span class="tcard-name">{who}</span>
    {detail && <span class="tcard-role">{detail}</span>}
    {d.org && <span class="tcard-org">{d.org}</span>}
    {translatedNote && <span class="tcard-note">{translatedNote}</span>}
  </figcaption>

  {mode === 'full' && (d.quote.trim() !== d.pull.trim() || d.original) && (
    <details class="tcard-more">
      <summary>{t('testimonials.full')}</summary>
      <div class="tcard-body">
        {paras(d.quote).map((p) => <p>{p}</p>)}
      </div>

      {d.original && (
        <details class="tcard-orig">
          <summary>{t('testimonials.showOriginal')}</summary>
          <div class="tcard-body" lang={d.originalLang}>
            {paras(d.original).map((p) => <p>{p}</p>)}
          </div>
        </details>
      )}
    </details>
  )}
</figure>

<style>
  .tcard-title {
    margin: 0;
    font-family: var(--f-sans);
    font-size: var(--t-1);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }
  .tcard {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    border-radius: 3px;
    padding: 1.45rem 1.4rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: calc(var(--navh) + 1rem);
  }
  .tcard--compact { height: 100%; }

  .tcard-pull { margin: 0; }
  .tcard-pull p {
    font-family: var(--f-serif);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: none;
    text-wrap: pretty;
  }
  :global(:lang(zh)) .tcard-pull p { font-size: 1.0625rem; line-height: 1.75; }

  .tcard-by {
    padding-top: .8rem;
    border-top: 1px solid var(--rule-soft);
    display: flex;
    flex-direction: column;
    gap: .1rem;
  }
  .tcard--compact .tcard-by { margin-top: auto; }
  .tcard-name { font-weight: 600; font-size: .9375rem; color: var(--ink); }
  .tcard-role, .tcard-org { font-size: .8125rem; color: var(--ink-soft); line-height: 1.45; }
  .tcard-note {
    margin-top: .35rem;
    font-size: .6875rem; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  :global(:lang(zh)) .tcard-note { letter-spacing: .04em; text-transform: none; font-size: .75rem; }

  /* ---- expanders ---- */
  .tcard-more, .tcard-orig { border-top: 1px solid var(--rule-soft); }
  .tcard-more summary, .tcard-orig summary {
    cursor: pointer;
    list-style: none;
    display: flex; align-items: center; gap: .5rem;
    padding-top: .75rem;
    font-size: .875rem; font-weight: 600;
    color: var(--brand);
  }
  .tcard-orig summary { font-weight: 500; color: var(--ink-soft); font-size: .8125rem; }
  .tcard-more summary::-webkit-details-marker,
  .tcard-orig summary::-webkit-details-marker { display: none; }
  .tcard-more summary::before, .tcard-orig summary::before {
    content: ""; width: .45rem; height: .45rem; flex: none;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg); transition: transform .15s ease;
  }
  .tcard-more[open] > summary::before,
  .tcard-orig[open] > summary::before { transform: rotate(45deg); }
  .tcard-more summary:focus-visible, .tcard-orig summary:focus-visible {
    outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 2px;
  }

  .tcard-body { display: flex; flex-direction: column; gap: .8rem; padding-top: .85rem; }
  .tcard-body p { font-size: .9375rem; line-height: 1.7; color: var(--ink-soft); max-width: none; }
  .tcard-orig { margin-top: 1rem; }
  .tcard-orig .tcard-body p { font-size: .875rem; }
</style>
