          ],
        },
        { h: '關於顧問', p: '本顧問持有有效的言語語言病理學家執照（CCC-SLP, ASHA）與國際認證行為分析師資格（BCBA, BACB）。這些專業資格構成 Speech & ABA Works 內容在品質與臨床基礎上的依據。您所獲得的諮詢或督導，均在本顧問於言語語言病理學與應用行為分析領域之專業範圍與能力之內提供。惟本顧問以 Speech & ABA Works 名義提供諮詢或督導時，並非擔任您的言語治療師或行為分析師。除非雙方已簽署明確載明督導或諮詢性臨床關係之書面協議，否則本方案不建立任何專業人員與個案之關係。' },
        { h: '給家庭與非專業人員', p: '針對家長或照顧者的內容與方案，旨在提供資訊、策略與技巧，以支持其所照顧的對象。此不能取代由領有執照之專業人員所進行的個別化評估或治療。我們鼓勵所有家庭與所在社區中合格且領有執照的實務工作者合作。' },
        { h: '司法管轄區說明', p: 'Speech & ABA Works 的參與者來自世界各地。執業範圍的相關法規因司法管轄區而異。參與者應自行了解並遵循其所在地區規範自身專業執照的執業範圍規定。' },
        { h: '疑問', p: `若您對於某項 Speech & ABA Works 服務是否適合您的情況有任何疑問，請於購買前來信 ${site.email} 與我們聯繫。` },
      ] as readonly Section[],
    },
  },
} as const;

const c = copyFor(copy, lang)[doc];
---

<PageHeader title={c.title} width="page">
  <p class="small muted">{copyFor(effective, lang)}</p>
</PageHeader>

<section class="band">
  <div class="shell">
    {c.intro && <p class="legal-intro">{c.intro}</p>}
    <ol class="legal">
      {c.sections.map((s) => (
        <li class="clause">
          <h2>{s.h}</h2>
          <div class="clause-body">
            {s.p && <p>{s.p}</p>}
            {s.items && (
              <ul>
                {s.items.map((it) => <li>{it}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="legal-contact small muted">
      {isZh(lang) ? '有疑問請來信 ' : 'Questions about any of this: '}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</section>

<style>
  .legal-intro { color: var(--ink-soft); font-size: .9375rem; max-width: 46rem; padding-block: 0 1.5rem; }
  .legal { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; counter-reset: clause; }
  .legal li { max-width: none; }
  .clause {
    counter-increment: clause;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: .35rem 1.25rem;
  }
  .clause:last-child { border-bottom: 1px solid var(--rule); }
  .clause::before {
    content: counter(clause, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--f-sans);
    font-size: .9375rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    padding-top: .35rem;
  }
  .clause h2 { font-size: var(--t-1); font-weight: 600; }
  .clause p { color: var(--ink-soft); font-size: .9375rem; }
  .clause-body > * + * { margin-top: .65rem; }
  .clause-body ul {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: .45rem;
  }
  .clause-body ul li {
    color: var(--ink-soft);
    font-size: .9375rem;
    line-height: 1.6;
  }
  @media (max-width: 34rem) {
    .clause { grid-template-columns: 1fr; }
    .clause::before { grid-row: auto; padding-top: 0; }
  }
  .legal-contact { padding-block: 1.75rem 0; }
</style>
