---
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';
import TestimonialCard from '../TestimonialCard.astro';
import { type Lang, copyFor, site } from '../../i18n/ui';
import { byLang, sortByOrder } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;

const items = sortByOrder(await byLang('testimonials', lang));

const copy = {
  en: {
    eyebrow: 'Testimonials',
    title: 'What colleagues and families say',
    lede: 'Supervisors, clinicians, educators and a parent I have worked with, in their own words. Testimonies written in Chinese appear here in English translation, with the original one click away.',
    reviewLead: 'Worked with me? A review on Google helps other families find this practice.',
    reviewLink: 'Leave a review on Google',
  },
  zh: {
    eyebrow: '真實回饋',
    title: '同業與家長的回饋',
    lede: '與我合作過的督導、臨床人員、教師與家長親筆寫下的回饋。以英文撰寫的回饋附有中文翻譯，並可查看原文。',
    reviewLead: '曾經與我合作過嗎？在 Google 留下一段回饋，能幫助更多家庭找到這裡。',
    reviewLink: '前往 Google 留下回饋',
  },
} as const;
const c = copyFor(copy, lang);
---

<PageHeader eyebrow={c.eyebrow} title={c.title} lede={c.lede} />

<section class="band band--tint">
  <div class="shell shell--wide">
    <ul class="tgrid">
      {items.map((item) => (
        <li><TestimonialCard item={item} lang={lang} mode="full" /></li>
      ))}
    </ul>
  </div>

  {site.googleReview && (
    <p class="reviewnote shell">
      {c.reviewLead}{' '}
      <a href={site.googleReview} target="_blank" rel="noopener">{c.reviewLink}</a>
    </p>
  )}
</section>

<CtaBand lang={lang} />

<style>
  .tgrid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 1.25rem;
    /* `start`, so opening one card does not stretch its neighbour. */
    align-items: start;
  }
  .tgrid li { max-width: none; }

  /* Deliberately quiet: this is an invitation at the foot of the page, not a
     call to action competing with the band below it. */
  .reviewnote {
    margin-block: 2.5rem 0;
    font-size: 0.9375rem;
    color: var(--muted);
    text-align: center;
    text-wrap: balance;
  }
  .reviewnote a { color: inherit; text-underline-offset: 0.2em; }
  .reviewnote a:hover { color: var(--ink); }
</style>
