---
/**
 * The testimonials band on Home and Services: the featured few as short
 * excerpts, and a link to the page that holds all of them.
 */
import TestimonialCard from './TestimonialCard.astro';
import { byLang, sortByOrder } from '../lib/content';
import { useTranslations, path, type Lang, isZh } from '../i18n/ui';

interface Props { lang: Lang; limit?: number; featuredOnly?: boolean; heading?: string }
const { lang, limit, featuredOnly = false, heading } = Astro.props;
const t = useTranslations(lang);

const all = sortByOrder(await byLang('testimonials', lang));
let items = featuredOnly ? all.filter((i) => i.data.featured) : all;
if (limit) items = items.slice(0, limit);
const moreLabel = t('testimonials.readAll').replace('{n}', String(all.length));
---

{items.length > 0 && (
  <section class="band">
    <div class="shell shell--wide stack stack-5">
      <div class="section-title">
        <p class="eyebrow">{isZh(lang) ? '真實回饋' : 'In their words'}</p>
        <h2>{heading ?? t('testimonials.heading')}</h2>
      </div>

      <ul class="quote-grid">
        {items.map((item) => (
          <li><TestimonialCard item={item} lang={lang} mode="compact" /></li>
        ))}
      </ul>

      {all.length > items.length && (
        <p class="quote-more">
          <a class="link-arrow" href={path('testimonials', lang)}>{moreLabel} <span aria-hidden="true">→</span></a>
        </p>
      )}
    </div>
  </section>
)}

<style>
  .quote-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18.5rem, 1fr));
    gap: 1.25rem;
  }
  .quote-grid li { max-width: none; }

  .quote-more { margin: 0; }
  .quote-more a {
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
    padding-bottom: .1rem;
  }
  .quote-more a:hover { border-bottom-color: var(--brand); }
</style>
