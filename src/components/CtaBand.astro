---
import { useTranslations, path, site, type Lang, copyFor, isZh } from '../i18n/ui';

interface Props { lang: Lang; title?: string; body?: string }
const { lang, title, body } = Astro.props;
const t = useTranslations(lang);

const defaults = {
  en: {
    title: 'Start with a free 20-minute call',
    body: 'Bring one case, one sticking point, or one question you have been carrying for months. No charge and no obligation — we work out together whether I am the right person to help.',
  },
  zh: {
    title: '從 20 分鐘免費諮詢開始',
    body: '帶著一個個案、一個卡住的環節，或一個你放在心裡很久的問題。免費、無需承諾——我們一起確認我是不是適合協助你的人。',
  },
} as const;
---

<section class="band band--brand">
  <div class="shell cta-inner">
    <div class="stack stack-3">
      <p class="eyebrow">{isZh(lang) ? '下一步' : 'Next step'}</p>
      <h2>{title ?? copyFor(defaults, lang).title}</h2>
      <p class="cta-body">{body ?? copyFor(defaults, lang).body}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={path('contact', lang)}>{t('cta.book')}</a>
      <a class="btn btn--ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta-inner { display: flex; flex-direction: column; gap: 1.75rem; align-items: flex-start; }
  .cta-inner h2 { max-width: 20ch; }
  .cta-body { max-width: 52ch; }
</style>
