---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/pages/BlogPost.astro';
import { allLangs, path } from '../../i18n/ui';
import { getCollection, render } from 'astro:content';

const LANG = 'en';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(
    (p) => p.id.startsWith('en/') && !p.data.draft,
  );
  return posts.map((post) => ({
    params: { slug: post.id.slice('en/'.length) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.slice(LANG.length + 1);

// Only offer a language alternate where that translation actually exists.
const all = await getCollection('posts');
const altHrefs = allLangs
  .filter((l) => all.some((p) => p.id === `${l}/${slug}` && !p.data.draft))
  .map((l) => ({ lang: l, href: `${path('blog', l)}/${slug}` }));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  altHrefs={altHrefs}
  ogType="article"
  image={post.data.hero}
>
  <BlogPost
    lang={LANG}
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    tags={post.data.tags}
    body={post.body ?? ''}
    hero={post.data.hero}
    heroAlt={post.data.heroAlt}
  >
    <Content />
  </BlogPost>
</BaseLayout>
